{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "REVIEW": ["SIGN"],
    "SIGN": ["OTP"],
    "OTP": ["SUCCESS"]
  },
  "screens": [
    {
      "id": "REVIEW",
      "title": "Revisar contrato",
      "data": {
        "signatureHash": {
          "type": "string",
          "__example__": "9807055eed68625f7aef1b62ac8a7603fdc7713e8dae2e1dcd714d99303cebaa"
        },
        "authenticationMethodId": {
          "type": "number",
          "__example__": 4
        },
        "documentTitle": {
          "type": "string",
          "__example__": "Contrato de Servicios #1234"
        },
        "companyName": {
          "type": "string",
          "__example__": "Nortex Consultores S.A.S."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.documentTitle}"
          },
          {
            "type": "TextBody",
            "text": "${data.companyName} te ha enviado el documento como archivo adjunto en este chat. Ábrelo para revisarlo antes de continuar."
          },
          {
            "type": "OptIn",
            "name": "accepted_terms",
            "label": "Acepto realizar la firma por medios electrónicos con plena validez jurídica.",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Firmar documento",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "SIGN"
              },
              "payload": {
                "accepted_terms": "${form.accepted_terms}",
                "signatureHash": "${data.signatureHash}",
                "authenticationMethodId": "${data.authenticationMethodId}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SIGN",
      "title": "Firmar",
      "data": {
        "accepted_terms": {
          "type": "boolean",
          "__example__": true
        },
        "signatureHash": {
          "type": "string",
          "__example__": "9807055eed68625f7aef1b62ac8a7603fdc7713e8dae2e1dcd714d99303cebaa"
        },
        "authenticationMethodId": {
          "type": "number",
          "__example__": 4
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Confirma tu firma"
          },
          {
            "type": "TextBody",
            "text": "Escribe tu nombre completo tal como aparece en tu documento de identidad. Esto se registrará como tu firma electrónica."
          },
          {
            "type": "TextInput",
            "name": "full_name",
            "label": "Nombre completo",
            "input-type": "text",
            "required": true
          },
          {
            "type": "OptIn",
            "name": "confirm_signature",
            "label": "Confirmo que este es mi nombre y que estoy firmando este documento.",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Siguiente",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "trigger": "request_otp",
                "full_name": "${form.full_name}",
                "signatureHash": "${data.signatureHash}",
                "authenticationMethodId": "${data.authenticationMethodId}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "OTP",
      "title": "Verificación",
      "data": {
        "full_name": {
          "type": "string",
          "__example__": "Juan Pérez"
        },
        "signatureHash": {
          "type": "string",
          "__example__": "9807055eed68625f7aef1b62ac8a7603fdc7713e8dae2e1dcd714d99303cebaa"
        },
        "authenticationMethodId": {
          "type": "number",
          "__example__": 4
        },
        "error_message": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Ingresa el código de verificación"
          },
          {
            "type": "TextBody",
            "text": "Enviado a tu WhatsApp registrado."
          },
          {
            "type": "TextBody",
            "text": "${data.error_message}",
            "visible": "${data.has_error}"
          },
          {
            "type": "TextInput",
            "name": "otp_code",
            "label": "Código de 4 dígitos",
            "input-type": "number",
            "required": true
          },
          {
            "type": "EmbeddedLink",
            "text": "¿No llegó? Reenviar",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "trigger": "resend",
                "signatureHash": "${data.signatureHash}",
                "authenticationMethodId": "${data.authenticationMethodId}"
              }
            }
          },
          {
            "type": "Footer",
            "label": "Confirmar y Finalizar Firma",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "trigger": "verify",
                "signatureHash": "${data.signatureHash}",
                "otpCode": "${form.otp_code}",
                "authenticationMethodId": "${data.authenticationMethodId}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SUCCESS",
      "title": "Listo",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "¡Documento firmado exitosamente!"
          },
          {
            "type": "TextBody",
            "text": "Hemos registrado tu firma. Puedes continuar con tu proceso."
          },
          {
            "type": "Footer",
            "label": "Volver a WhatsApp",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}
